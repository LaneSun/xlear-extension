  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wxt": "^0.21.4"
